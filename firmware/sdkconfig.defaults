# Reserve native USB Serial/JTAG for the provisioning driver. Disable console
# output on UART0 / GPIO11, used by a button input.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set

# The XIAO ESP32-C5 has 8 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Preserve the default NVS layout and give the MQTT/TLS application 2 MB.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Encrypt NVS using keys derived from a hardware-protected HMAC key in KEY0.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=0

# XIAO ESP32-C5 wiring: D4=SDA, D5=SCL, D7=radar TX -> UART1 RX.
CONFIG_STATION_PINS_VERIFIED=y
CONFIG_STATION_SDA=23
CONFIG_STATION_SCL=24
CONFIG_STATION_RADAR_RX=12
CONFIG_STATION_LED=27
CONFIG_STATION_LED_ACTIVE_LOW=y
CONFIG_STATION_LED_MOTION=y

# The async MQTT sender otherwise polls its queued outbox only once per second.
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_POLL_READ_TIMEOUT_MS=10
